#!/usr/bin/env python3
"""Print the Git tree for a source-only release from a committed revision."""
from pathlib import PurePosixPath
import os
import subprocess
import sys
import tempfile

revision = sys.argv[1] if len(sys.argv) == 2 else "HEAD"
if len(sys.argv) > 2:
    raise SystemExit("usage: scripts/source-tree [revision]")

def git(*args, **kwargs):
    return subprocess.check_output(["git", *args], **kwargs)

# Only named source locations and types can enter the public history. Inspect the
# selected blobs too, so a media file renamed to a source extension fails closed.
entries = []
for entry in git("ls-tree", "-rz", revision).split(b"\0"):
    if not entry:
        continue
    meta, name = entry.split(b"\t", 1)
    mode, kind, oid = meta.split()
    path = PurePosixPath(name.decode())
    top = path.parts[0]
    if top in {"build", ".git"} or kind != b"blob" or mode not in {b"100644", b"100755"}:
        continue
    allowed = (
        (len(path.parts) == 1 and name.decode() in {".gitignore", "README.md", "LOOPS.md", "mise.toml", "preview.py"})
        or (top in {"linux-four", "native", "tests"} and
            (path.suffix in {".py", ".h", ".cpp", ".rs", ".patch", ".md", ".html"} or path.name == "LICENSE"))
        or (top in {"scripts", ".githooks"} and len(path.parts) == 2)
        or (path.parts[:2] == (".github", "workflows") and path.suffix in {".yml", ".yaml"})
        or (path.parts[:2] == (".agents", "skills") and path.suffix in {".md", ".yaml", ".py", ".sh"})
    )
    if allowed:
        data = git("cat-file", "blob", oid.decode())
        data.decode("utf-8")
        if b"\0" in data or (top in {"scripts", ".githooks"} and not data.startswith(b"#!")):
            raise SystemExit(f"Unexpected file format in {path}")
        entries.append(b" ".join((mode, oid)) + b"\t" + name + b"\0")

with tempfile.TemporaryDirectory() as temp:
    env = dict(os.environ, GIT_INDEX_FILE=os.path.join(temp, "index"))
    git("read-tree", "--empty", env=env)
    git("update-index", "-z", "--index-info", env=env, input=b"".join(entries))
    print(git("write-tree", env=env).decode().strip())
