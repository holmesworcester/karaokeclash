#!/usr/bin/env python3
"""Provision a source checkout from a local desk data directory."""
import argparse
import os
from pathlib import Path
import shutil
import tempfile

ROOT = Path(__file__).resolve().parents[1]
PATTERNS = ("linux-four/*.json", "linux-four/*.flac", "linux-four/basic-pitch/*.onnx",
            "linux-four/recording-parts/*.json", "linux-four/recording-parts/versions/*.json.gz",
            "linux-four/starred-arrangements/*.json", "linux-four/starred-arrangements/*.mid",
            "linux-four/vocoder-scores/*.json", "tests/fixtures/homer/*.flac", "tests/fixtures/catalog-clocks.csv")
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("action", choices=("store", "link"))
parser.add_argument("directory", type=Path, nargs="?", default=os.environ.get(
    "KARAOKE_DESK_ASSETS", Path(os.environ.get("XDG_DATA_HOME", Path.home()/".local/share")) /
    "karaoke-playground-4/desk-assets"))
args = parser.parse_args()
private = args.directory.expanduser().resolve()
source, target = (ROOT, private) if args.action == "store" else (private, ROOT)
for pattern in PATTERNS:
    for item in sorted(source.glob(pattern)):
        dest = target / item.relative_to(source)
        if dest.exists() and item.samefile(dest):
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        if args.action == "link":
            if not dest.exists():
                dest.symlink_to(item)
        else:
            with tempfile.NamedTemporaryFile(dir=dest.parent, delete=False) as tmp:
                path = Path(tmp.name)
            try:
                shutil.copy2(item, path)
                path.replace(dest)
            finally:
                path.unlink(missing_ok=True)
